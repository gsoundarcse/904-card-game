# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Feature flags for auth providers/delivery that aren't wired up yet — leave
# off (false/unset) until real credentials are added. See lib/feature-flags.ts.
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

AUTH_EMAIL_ENABLED=false

# Optional: override where the local SQLite file (users + match history) is written.
# APP_DB_PATH=./data/app.db

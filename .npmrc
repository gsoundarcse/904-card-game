# Pin to the public registry. Without this, installs on this machine resolve
# through a corporate proxy (npm.dev.paypalinc.com) and pnpm records that
# proxy's internal tarball URLs directly into pnpm-lock.yaml. Render (and any
# other outside CI) can't reach that internal host, and pnpm's supply-chain
# check also rejects lockfile entries whose tarball URL doesn't match what
# the public registry reports for that package.
registry=https://registry.npmjs.org/
